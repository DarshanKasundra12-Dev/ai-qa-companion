# ==============================================================================
# QAForge Frontend Environment Variables
# ==============================================================================

# Supabase Configuration
# You can find these in your Supabase project settings -> API
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# AI Gateway (Used for the API Inference and Script Generation)
LOVABLE_API_KEY="YOUR_LOVABLE_API_KEY_OR_GEMINI_KEY"

# Backend Socket URL (Defaults to localhost during development)
VITE_AUTOMATION_SERVER_URL="http://localhost:4000"
