# ==============================================================================
# QAForge Automation Server Environment Variables
# ==============================================================================

PORT=4000

# Gemini / Groq API Key for AI Self-Healing Selectors
# (currently expects a Groq key starting with "gsk_")
GEMINI_API_KEY=""

# Supabase — used to authenticate WebSocket connections via Supabase JWT.
# Required in production. If both are empty, the server runs in open-dev mode.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional — only if you want service-role privileges server-side:
SUPABASE_SERVICE_ROLE_KEY=""
